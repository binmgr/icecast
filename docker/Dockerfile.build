# =============================================================================
# Icecast Build Environment
# =============================================================================
FROM alpine:latest

# Install ALL build tools and static libraries
RUN apk add --no-cache \
    build-base curl wget git autoconf automake libtool pkgconf \
    linux-headers tar xz bzip2 ca-certificates perl python3 \
    # Static libraries (native amd64)
    zlib-static openssl-libs-static libxml2-static libxslt-static \
    libogg-static libvorbis-static libtheora-static curl-static libmaxminddb-static \
    nghttp2-static brotli-static libidn2-static \
    # Dev headers
    zlib-dev openssl-dev libxml2-dev libxslt-dev \
    libogg-dev libvorbis-dev libtheora-dev curl-dev libmaxminddb-dev

# Build libigloo (not in Alpine)
RUN git clone --depth 1 https://gitlab.xiph.org/xiph/icecast-libigloo.git && cd icecast-libigloo && \
    autoreconf -fi && ./configure --prefix=/usr --disable-shared --enable-static && \
    make -j$(nproc) && make install && cd .. && rm -rf icecast-libigloo

WORKDIR /build

# Build script
COPY <<'EOF' /usr/local/bin/build-icecast
#!/bin/sh
set -e
ARCH="${1:-amd64}"
case "$ARCH" in
    amd64)
        CC=gcc; STRIP=strip; HOST=""
        PKG_CONFIG_PATH="/usr/lib/pkgconfig"
        PREFIX="/usr"
        ;;
    *) echo "Only amd64 supported for now"; exit 1 ;;
esac

cd /build
git clone --recursive https://github.com/xiph/Icecast-Server.git && cd Icecast-Server
VERSION=$(sed -n 's/^AC_INIT(\[Icecast\], \[\([0-9.]*\)\].*/\1/p' configure.ac || echo "2.5.0")

export CC PKG_CONFIG_PATH
autoreconf -fi
CFLAGS="-Os -I${PREFIX}/include" LDFLAGS="-L${PREFIX}/lib" ./configure ${HOST} \
    --prefix=/usr --enable-yp --enable-ipv6 --without-speex --with-libmaxminddb="${PREFIX}"
make -j$(nproc) AM_CFLAGS="-static" AM_LDFLAGS="-static -all-static"
${STRIP} src/icecast

mkdir -p /output
cp src/icecast /output/icecast-linux-${ARCH}
echo "${VERSION}" > /output/VERSION
echo "Built: /output/icecast-linux-${ARCH} (v${VERSION})"
EOF

RUN chmod +x /usr/local/bin/build-icecast
WORKDIR /workspace
CMD ["echo", "Usage: build-icecast [amd64]"]
